# Grafana Admin Credentials
#
# REQUIRED: Copy this file to .env and set secure values before deploying:
#   cp .env.example .env
#   nano .env  # Edit with your secure credentials
#
# IMPORTANT SECURITY NOTES:
# - These credentials apply ONLY on Grafana's first startup
# - If grafana-storage volume exists, it keeps the old password until reset with:
#   docker exec -it <grafana-container> grafana cli admin reset-admin-password <new-password>
# - The original default password was committed to git history (commit fe0f4e3, Oct 2025)
#   and MUST be treated as compromised. Rotate it immediately if it was used elsewhere.
# - Use a strong, unique password (16+ characters, mixed case, numbers, symbols)
#
GF_SECURITY_ADMIN_USER=your_admin_username
GF_SECURITY_ADMIN_PASSWORD=your_secure_password
